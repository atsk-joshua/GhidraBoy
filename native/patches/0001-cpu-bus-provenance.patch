+/* Instrument direct CPU bus operations, excluding hardware work in advance_cycles.
+ * Writes are attempts before GB_write_memory performs bus blocking/commit.
+ * Reads report the returned bus value, including blocked/redirected reads. */
+static uint8_t ghigbc_cpu_read(GB_gameboy_t *gb, uint16_t addr)
+{
+    uint8_t value = GB_read_memory(gb, addr);
+    if (gb->ghigbc_bus_callback) gb->ghigbc_bus_callback(gb, addr, value, false, gb->ghigbc_origin);
+    return value;
+}
+static void ghigbc_cpu_write(GB_gameboy_t *gb, uint16_t addr, uint8_t value)
+{
+    if (gb->ghigbc_bus_callback) gb->ghigbc_bus_callback(gb, addr, value, true, gb->ghigbc_origin);
+    GB_write_memory(gb, addr, value);
+}
+
