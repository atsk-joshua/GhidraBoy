:SWAP (HL) is op0_8=0xcb & HL; op0_8=0x36 {
  gb_state_entry();
  local widePtr323_0:4 = zext(HL);
  local val:1 = *:1 widePtr323_0;
  aluSwap(val);
  local widePtr325_0:4 = zext(HL);
  *:1 widePtr325_0 = val;
}

:SRL reg0_3 is op0_8=0xcb; op6_2=0b00 & op3_3=0b111 & reg0_3 {
