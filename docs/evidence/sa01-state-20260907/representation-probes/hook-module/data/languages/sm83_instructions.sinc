:RLCA is op0_8=0x07 {
  gb_state_entry();
  # TODO: double-check flags
  local co:1 = A[7,1];
  A = (A << 1) | co;
  $(Z_flag) = 0;
  $(N_flag) = 0;
  $(H_flag) = 0;
  $(C_flag) = co;
}

:RLA is op0_8=0x17 {
  gb_state_entry();
  # TODO: double-check flags
  local co:1 = A[7,1];
  A = (A << 1) | $(C_flag);
  $(Z_flag) = 0;
  $(N_flag) = 0;
  $(H_flag) = 0;
  $(C_flag) = co;
}

:RRCA is op0_8=0x0f {
  gb_state_entry();
  # TODO: double-check flags
  local co:1 = A[0,1];
  A = (co << 7) | (A >> 1);
  $(Z_flag) = 0;
  $(N_flag) = 0;
  $(H_flag) = 0;
  $(C_flag) = co;
}

:RRA is op0_8=0x1f {
  gb_state_entry();
  # TODO: double-check flags
  local co:1 = A[0,1];
  A = ($(C_flag) << 7) | (A >> 1);
  $(Z_flag) = 0;
  $(N_flag) = 0;
  $(H_flag) = 0;
  $(C_flag) = co;
}

:RLC reg0_3 is op0_8=0xcb; op6_2=0b00 & op3_3=0b000 & reg0_3 {
  gb_state_entry();
  aluRlc(reg0_3);
}

:RLC (HL) is op0_8=0xcb & HL; op0_8=0x06 {
  gb_state_entry();
  local widePtr263_0:4 = zext(HL);
  local val:1 = *:1 widePtr263_0;
  aluRlc(val);
  local widePtr265_0:4 = zext(HL);
  *:1 widePtr265_0 = val;
}

:RRC reg0_3 is op0_8=0xcb; op6_2=0b00 & op3_3=0b001 & reg0_3 {
