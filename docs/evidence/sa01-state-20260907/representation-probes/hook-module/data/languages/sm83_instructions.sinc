:INC (HL) is op0_8=0x34 & HL {
  gb_state_entry();
  local widePtr203_0:4 = zext(HL);
  local val:1 = *:1 widePtr203_0;
  aluInc(val);
  local widePtr205_0:4 = zext(HL);
  *:1 widePtr205_0 = val;
}

