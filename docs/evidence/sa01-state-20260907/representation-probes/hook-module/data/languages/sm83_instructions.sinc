:BIT bit3_3, reg0_3 is op0_8=0xcb; op6_2=0b01 & bit3_3 & reg0_3 {
  gb_state_entry();
  aluBit(bit3_3, reg0_3);
}

:BIT bit3_3, (HL) is op0_8=0xcb & HL; op6_2=0b01 & bit3_3 & op0_3=0b110 {
