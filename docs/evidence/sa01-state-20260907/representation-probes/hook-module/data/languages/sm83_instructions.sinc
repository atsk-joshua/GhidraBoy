}

:SET bit3_3, (HL) is op0_8=0xcb & HL; op6_2=0b11 & bit3_3 & op0_3=0b110 {
  gb_state_entry();
  local widePtr362_0:4 = zext(HL);
  local val:1 = *:1 widePtr362_0;
  aluSet(bit3_3, val);
  local widePtr364_0:4 = zext(HL);
  *:1 widePtr364_0 = val;
}

# Control

:JP Addr16 is op0_8=0xc3; Addr16 {
  gb_state_entry();
  goto Addr16;
}

:JP HL is op0_8=0xe9 & HL {
  gb_state_entry();
  goto [HL];
}

:JR RelAddr8 is op0_8=0x18; RelAddr8 {
  gb_state_entry();
  goto RelAddr8;
}

:CALL Addr16 is op0_8=0xcd; Addr16 {
  gb_state_entry();
  push16(&:2 inst_next);
  call Addr16;
}

:RET is op0_8=0xc9 {
  gb_state_entry();
  pop16(PC);
  return [PC];
}

:RETI is op0_8=0xd9 {
  gb_state_entry();
  pop16(PC);
  local ime:1 = 1;
  IME(ime);
  return [PC];
}

:JP cc, Addr16 is op5_3=0b110 & cc & op0_3=0b010; Addr16 {
  gb_state_entry();
  if (cc) goto Addr16;
}

:JR cc, RelAddr8 is op5_3=0b001 & cc & op0_3=0b000; RelAddr8 {
  gb_state_entry();
  if (cc) goto RelAddr8;
}

:CALL cc, Addr16 is op5_3=0b110 & cc & op0_3=0b100; Addr16 {
  gb_state_entry();
  if (!cc) goto inst_next;
  push16(&:2 inst_next);
  call Addr16;
}

:RET cc is op5_3=0b110 & cc & op0_3=0b000 {
  gb_state_entry();
  if (!cc) goto inst_next;
  pop16(PC);
  return [PC];
}

:RST RstAddr is op6_2=0b11 & RstAddr & op0_3=0b111 {
  gb_state_entry();
  push16(&:2 inst_next);
  call RstAddr;
}

# Miscellaneous

:HALT is op0_8=0x76 {
  gb_state_entry();
  halt();
}

:STOP is op0_8=0x10 {
  gb_state_entry();
  stop();
}

:DI is op0_8=0xf3 {
  gb_state_entry();
  local ime:1 = 0;
  IME(ime);
}

:EI is op0_8=0xfb {
  gb_state_entry();
  local ime:1 = 1;
  IME(ime);
}

:CCF is op0_8=0x3f {
  gb_state_entry();
  $(N_flag) = 0;
  $(H_flag) = 0;
  $(C_flag) = !$(C_flag);
}

:SCF is op0_8=0x37 {
  gb_state_entry();
  $(N_flag) = 0;
  $(H_flag) = 0;
  $(C_flag) = 1;
}

:NOP is op0_8=0x00 {
  gb_state_entry();
}

:DAA is op0_8=0x27 {
  gb_state_entry();
  # Snapshot all overlapping inputs. Keep the unused legacy userop declaration
  # so existing userop indices remain stable; arithmetic needs no callback.
  local old:1 = A;
  local n:1 = $(N_flag);
  local h:1 = $(H_flag);
  local c:1 = $(C_flag);
  # Boolean corrections and an 8-bit add/subtract factor express both paths
  # without artificial basic blocks when preceding arithmetic fixes N/H/C.
  local low:1 = h || (!n && ((old & 0xf) > 9));
  local high:1 = c || (!n && (old > 0x99));
  local correction:1 = (low * 6) + (high * 0x60);
  local direction:1 = 1 - (n * 2);
  A = old + (correction * direction);
  $(Z_flag) = (A == 0);
  $(H_flag) = 0;
  $(C_flag) = high;
}

:CPL is op0_8=0x2f {
  gb_state_entry();
  A = ~A;
  $(N_flag) = 1;
  $(H_flag) = 1;
}

# 16-bit loads

:LD dregpair4_2, imm16 is op6_2=0b00 & dregpair4_2 & op0_4=0b0001; imm16 {
  gb_state_entry();
  dregpair4_2 = imm16;
}

:LD Mem16, SP is op0_8=0x08 & SP; Mem16 {
  gb_state_entry();
  gb_direct_write16(&:2 Mem16, SP);
}

:LD SP, HL is op0_8=0xf9 & SP & HL {
  gb_state_entry();
  SP = HL;
}

:LD HL, SP+simm8 is op0_8=0xf8 & HL & SP; simm8 {
  gb_state_entry();
  # TODO: double-check flags
  local tmp:2 = SP + simm8;
  $(Z_flag) = 0;
  $(N_flag) = 0;
  $(H_flag) = (((SP:1 & 0xf) + (simm8 & 0xf)) & 0x10) != 0;
  $(C_flag) = carry(SP:1, simm8);
  HL = tmp;
}

:LD HL, SP-val is op0_8=0xf8 & HL & SP; simm8 & sign8=1 [
  val = -simm8;
] {
  # TODO: double-check flags
  local tmp:2 = SP + simm8;
  $(Z_flag) = 0;
  $(N_flag) = 0;
  $(H_flag) = (((SP:1 & 0xf) + (simm8 & 0xf)) & 0x10) != 0;
  $(C_flag) = carry(SP:1, simm8);
  HL = tmp;
}

:PUSH qregpair4_2 is op6_2=0b11 & qregpair4_2 & op0_4=0b0101 {
  gb_state_entry();
  push16(qregpair4_2);
}

:POP qregpair4_2 is op6_2=0b11 & qregpair4_2 & op0_4=0b0001 & op3_3 {
  gb_state_entry();
  pop16(qregpair4_2);
  # Retain the original constructor and token bindings for saved parse trees.
  # Non-AF POPs use an all-ones mask; POP AF alone clears the unused flag bits.
  local pairIndex:1 = op3_3;
  local isAf:1 = (pairIndex == 6);
  local flagMask:1 = 0xff - (isAf * 0xf);
  F = F & flagMask;
}

# 16-bit arithmetic

:ADD HL, sregpair4_2 is op6_2=0b00 & sregpair4_2 & op0_4=0b1001 & HL {
  gb_state_entry();
  # TODO: double-check flags
  local tmp:2 = HL + sregpair4_2;
  $(N_flag) = 0;
  $(H_flag) = (((HL & 0xfff) + (sregpair4_2 & 0xfff)) & 0x1000) != 0;
  $(C_flag) = carry(HL, sregpair4_2);
  HL = tmp;
}

:ADD SP, simm8 is op0_8=0xe8 & SP; simm8 {
  gb_state_entry();
  # TODO: double-check flags
  local tmp:2 = SP + simm8;
  $(Z_flag) = 0;
  $(N_flag) = 0;
  $(H_flag) = (((SP:1 & 0xf) + (simm8 & 0xf)) & 0x10) != 0;
  $(C_flag) = carry(SP:1, simm8);
  SP = tmp;
}

:INC sregpair4_2 is op6_2=0b00 & sregpair4_2 & op0_4=0b0011 {
  gb_state_entry();
  sregpair4_2 = sregpair4_2 + 1;
}

:DEC sregpair4_2 is op6_2=0b00 & sregpair4_2 & op0_4=0b1011 {
  gb_state_entry();
  sregpair4_2 = sregpair4_2 - 1;
}
