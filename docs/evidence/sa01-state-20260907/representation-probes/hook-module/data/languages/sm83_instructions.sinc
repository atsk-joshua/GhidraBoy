# 8-bit loads

:LD reg3_3, reg0_3 is op6_2=0b01 & reg3_3 & reg0_3 {
  gb_state_entry();
  reg3_3 = reg0_3;
}

:LD reg3_3, imm8 is op6_2=0b00 & reg3_3 & op0_3=0b110; imm8 {
  gb_state_entry();
  reg3_3 = imm8;
}

:LD reg3_3, (HL) is op6_2=0b01 & reg3_3 & op0_3=0b110 & HL {
  gb_state_entry();
  local widePtr25_0:4 = zext(HL);
  reg3_3 = *:1 widePtr25_0;
}

:LD (HL), reg0_3 is op6_2=0b01 & op3_3=0b110 & reg0_3 & HL {
  gb_state_entry();
  local widePtr29_0:4 = zext(HL);
  *:1 widePtr29_0 = reg0_3;
}

:LD (HL), imm8 is op0_8=0x36 & HL; imm8 {
  gb_state_entry();
  local widePtr33_0:4 = zext(HL);
  *:1 widePtr33_0 = imm8;
}

:LD A, (BC) is op0_8=0x0a & A & BC {
  gb_state_entry();
  local widePtr37_0:4 = zext(BC);
  A = *:1 widePtr37_0;
}

:LD A, (DE) is op0_8=0x1a & A & DE {
  gb_state_entry();
  local widePtr41_0:4 = zext(DE);
  A = *:1 widePtr41_0;
}

:LDH A, CMem8 is op0_8=0xf2 & A & CMem8 {
  gb_state_entry();
  A = CMem8;
}

:LDH CMem8, A is op0_8=0xe2 & A & CMem8 {
  gb_state_entry();
  CMem8 = A;
}

:LDH A, HiMem8 is op0_8=0xf0 & A; HiMem8 {
  gb_state_entry();
  A = HiMem8;
}

:LDH HiMem8, A is op0_8=0xe0 & A; HiMem8 {
  gb_state_entry();
  HiMem8 = A;
}

:LD A, Mem8 is op0_8=0xfa & A; Mem8 {
  gb_state_entry();
  A = Mem8;
}

:LD Mem8, A is op0_8=0xea & A; Mem8 {
  gb_state_entry();
  gb_direct_write8(&:2 Mem8, A);
}

:LD A, HLInc is op0_8=0x2a & A & HLInc {
  gb_state_entry();
  A = HLInc;
}

:LD A, HLDec is op0_8=0x3a & A & HLDec {
  gb_state_entry();
  A = HLDec;
}

:LD (BC), A is op0_8=0x02 & A & BC {
  gb_state_entry();
  local widePtr77_0:4 = zext(BC);
  *:1 widePtr77_0 = A;
}

:LD (DE), A is op0_8=0x12 & A & DE {
  gb_state_entry();
  local widePtr81_0:4 = zext(DE);
  *:1 widePtr81_0 = A;
}

:LD HLInc, A is op0_8=0x22 & A & HLInc {
  gb_state_entry();
  HLInc = A;
}

:LD HLDec, A is op0_8=0x32 & A & HLDec {
  gb_state_entry();
  HLDec = A;
}

# 8-bit arithmetic

:ADD reg0_3 is op6_2=0b10 & op3_3=0b000 & reg0_3 {
  gb_state_entry();
  aluAdd(reg0_3);
}

:ADD imm8 is op0_8=0xc6; imm8 {
  gb_state_entry();
  aluAdd(imm8);
}

:ADD (HL) is op0_8=0x86 & HL {
  gb_state_entry();
  local widePtr103_0:4 = zext(HL);
  local val:1 = *:1 widePtr103_0;
  aluAdd(val);
}

