<compiler_spec>
  <data_organization>
    <machine_alignment value="1"/>
    <default_alignment value="1"/>
    <default_pointer_alignment value="1"/>
    <pointer_size value="2"/>
    <integer_size value="2"/>
  </data_organization>
  <global>
    <range space="ram"/>
  </global>
  <stackpointer register="SP" space="ram" growth="negative"/>
  <returnaddress>
    <varnode space="stack" offset="0" size="2"/>
  </returnaddress>
  <!-- Validated scalar ordinary convention, SDCC 4.5.1 #15267, GBDK 4.5.0.
       Current call1 variants require explicit first-argument width selection.
       Variadic, aggregates and banked calls require custom storage. -->
  <default_proto>
    <prototype name="__sdcc451_call1_first16" extrapop="unknown" stackshift="2">
      <input><pentry minsize="2" maxsize="2"><register name="DE"/></pentry><group><pentry minsize="1" maxsize="1"><register name="A"/></pentry><pentry minsize="2" maxsize="2"><register name="BC"/></pentry></group><pentry minsize="1" maxsize="500" align="1"><addr offset="2" space="stack"/></pentry></input>
      <output><pentry minsize="1" maxsize="1"><register name="A"/></pentry><pentry minsize="2" maxsize="2"><register name="BC"/></pentry><pentry minsize="4" maxsize="4"><addr space="join" piece1="DE" piece2="BC"/></pentry></output>
      <unaffected><register name="SP"/></unaffected>
      <killedbycall><register name="AF"/><register name="BC"/><register name="DE"/><register name="HL"/></killedbycall>
    </prototype>
  </default_proto>

  <!-- Explicit per-function conventions; assembly default is unchanged. -->
<prototype name="__sdcc451_call1_first8" extrapop="unknown" stackshift="2">
      <input><pentry minsize="1" maxsize="1"><register name="A"/></pentry><pentry minsize="1" maxsize="2"><register name="DE"/></pentry><pentry minsize="1" maxsize="500" align="1"><addr offset="2" space="stack"/></pentry></input>
      <output><pentry minsize="1" maxsize="1"><register name="A"/></pentry><pentry minsize="2" maxsize="2"><register name="BC"/></pentry><pentry minsize="4" maxsize="4"><addr space="join" piece1="DE" piece2="BC"/></pentry></output>
      <unaffected><register name="SP"/></unaffected>
      <killedbycall><register name="AF"/><register name="BC"/><register name="DE"/><register name="HL"/></killedbycall>
    </prototype>
<prototype name="__sdcc451_call0" extrapop="2" stackshift="2">
      <input><pentry minsize="1" maxsize="500" align="1"><addr offset="2" space="stack"/></pentry></input>
      <output><pentry minsize="1" maxsize="1"><register name="E"/></pentry><pentry minsize="2" maxsize="2"><register name="DE"/></pentry><pentry minsize="4" maxsize="4"><addr space="join" piece1="HL" piece2="DE"/></pentry></output>
      <unaffected><register name="SP"/></unaffected>
      <killedbycall><register name="AF"/><register name="BC"/><register name="DE"/><register name="HL"/></killedbycall>
    </prototype>
<prototype name="__sdcc451_call1_first32" extrapop="unknown" stackshift="2">
      <input><pentry minsize="2" maxsize="2"><register name="DE"/></pentry><pentry minsize="2" maxsize="2"><register name="BC"/></pentry><pentry minsize="4" maxsize="4"><addr space="join" piece1="DE" piece2="BC"/></pentry><pentry minsize="1" maxsize="500" align="1"><addr offset="2" space="stack"/></pentry></input>
      <output><pentry minsize="1" maxsize="1"><register name="A"/></pentry><pentry minsize="2" maxsize="2"><register name="BC"/></pentry><pentry minsize="4" maxsize="4"><addr space="join" piece1="DE" piece2="BC"/></pentry></output>
      <unaffected><register name="SP"/></unaffected>
      <killedbycall><register name="AF"/><register name="BC"/><register name="DE"/><register name="HL"/></killedbycall>
    </prototype>
<prototype name="__sdcc451_variadic" extrapop="2" stackshift="2">
      <input><pentry minsize="1" maxsize="500" align="1"><addr offset="2" space="stack"/></pentry></input>
      <output><pentry minsize="1" maxsize="1"><register name="A"/></pentry><pentry minsize="2" maxsize="2"><register name="BC"/></pentry><pentry minsize="4" maxsize="4"><addr space="join" piece1="DE" piece2="BC"/></pentry></output>
      <unaffected><register name="SP"/></unaffected>
      <killedbycall><register name="AF"/><register name="BC"/><register name="DE"/><register name="HL"/></killedbycall>
    </prototype>
<prototype name="__sdcc451_banked_callee" extrapop="2" stackshift="2">
      <input><pentry minsize="1" maxsize="500" align="1"><addr offset="6" space="stack"/></pentry></input>
      <output><pentry minsize="1" maxsize="1"><register name="A"/></pentry><pentry minsize="2" maxsize="2"><register name="BC"/></pentry><pentry minsize="4" maxsize="4"><addr space="join" piece1="DE" piece2="BC"/></pentry></output>
      <unaffected><register name="SP"/></unaffected>
      <killedbycall><register name="AF"/><register name="BC"/><register name="DE"/><register name="HL"/></killedbycall>
    </prototype>
<prototype name="__sdcc451_preserves_bc" extrapop="unknown" stackshift="2">
      <input><pentry minsize="1" maxsize="1"><register name="A"/></pentry><pentry minsize="1" maxsize="2"><register name="DE"/></pentry><pentry minsize="1" maxsize="500" align="1"><addr offset="2" space="stack"/></pentry></input>
      <output><pentry minsize="1" maxsize="1"><register name="A"/></pentry></output>
      <unaffected><register name="SP"/><register name="BC"/></unaffected>
      <killedbycall><register name="AF"/><register name="DE"/><register name="HL"/></killedbycall>
    </prototype>
<prototype name="__sdcc416" extrapop="2" stackshift="2">
      <input><pentry minsize="1" maxsize="500" align="1"><addr offset="2" space="stack"/></pentry></input>
      <output><pentry minsize="1" maxsize="1"><register name="E"/></pentry><pentry minsize="2" maxsize="2"><register name="DE"/></pentry><pentry minsize="4" maxsize="4"><addr space="join" piece1="HL" piece2="DE"/></pentry></output>
      <unaffected><register name="SP"/></unaffected>
      <killedbycall><register name="AF"/><register name="BC"/><register name="DE"/><register name="HL"/></killedbycall>
    </prototype>
  <callotherfixup targetop="gb_direct_write8">
    <pcode dynamic="true">
      <input name="cpuAddress" size="2"/>
      <input name="value" size="1"/>
    </pcode>
  </callotherfixup>
  <callotherfixup targetop="gb_direct_write16">
    <pcode dynamic="true">
      <input name="cpuAddress" size="2"/>
      <input name="value" size="2"/>
    </pcode>
  </callotherfixup>
  <callfixup name="ghidraboy_software_call_v1">
    <pcode dynamic="true"/>
  </callfixup>
  <callfixup name="ghidraboy_may_return_v1">
    <pcode dynamic="true"/>
  </callfixup>
  <!-- Explicit state graph protocol; requires the optional pre-flow native companion. -->
  <prototype name="__ghidraboy_state_entry_v1" extrapop="unknown" stackshift="2">
      <input><pentry minsize="2" maxsize="2"><register name="DE"/></pentry><group><pentry minsize="1" maxsize="1"><register name="A"/></pentry><pentry minsize="2" maxsize="2"><register name="BC"/></pentry></group><pentry minsize="1" maxsize="500" align="1"><addr offset="2" space="stack"/></pentry></input>
      <output><pentry minsize="1" maxsize="1"><register name="A"/></pentry><pentry minsize="2" maxsize="2"><register name="BC"/></pentry><pentry minsize="4" maxsize="4"><addr space="join" piece1="DE" piece2="BC"/></pentry></output>
      <unaffected><register name="SP"/></unaffected>
      <killedbycall><register name="AF"/><register name="BC"/><register name="DE"/><register name="HL"/></killedbycall>
      <pcode inject="uponentry" dynamic="true"/>
    </prototype>
</compiler_spec>
